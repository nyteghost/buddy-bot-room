# Env file for docker-compose.unraid.yml (Docker Compose Manager -> Edit Env File). Everything is optional.
# Most connections (Plex, Trakt, Jellyfin, weather, mail...) can also be set up later inside Pixel Pals: Settings (or /setup).

# Where data is kept on the array/cache (chats, backups, Radicale, Ollama models, Tailscale login).
APPDATA=/mnt/user/appdata/pixelpals
BUDDY_PORT=8090
BUDDY_TZ=America/New_York

# Turn on optional parts (comma separated): tailscale, radicale, ollama
COMPOSE_PROFILES=

# Local AI. Leave empty to skip, point at Ollama on another machine, or use the bundled one (profile "ollama").
#   OLLAMA_URL=http://ollama:11434          (bundled; add "ollama" to COMPOSE_PROFILES)
#   OLLAMA_URL=http://10.200.1.50:11434     (Ollama on your gaming PC)
OLLAMA_URL=
# OLLAMA_RUNTIME=nvidia   # only for the bundled Ollama on an NVIDIA GPU (needs the Nvidia Driver plugin)

# Private HTTPS link from your phone (profile "tailscale"): a reusable key from the Tailscale admin console.
TS_AUTHKEY=
TS_HOSTNAME=pixelpals

# iPhone Reminders sync (profile "radicale")
RADICALE_USER=pixelpals
RADICALE_PASSWORD=

# Optional protection and alerts
BUDDY_PASSWORD=
NTFY_URL=

# Your Unraid server (watcher and phone alerts): Settings -> Management Access -> API Keys (read-only is enough)
UNRAID_URL=
UNRAID_API_KEY=

# Media and lists
PLEX_URL=
PLEX_TOKEN=
SEERR_URL=
SEERR_API_KEY=
JELLYFIN_URL=
JELLYFIN_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_USER=
TRAKT_ACCESS_TOKEN=

# Web search (SearXNG) and weather
SEARXNG_URL=
WEATHER_LOCATION=

# Local-Only AI: "on" (default) means every answer uses only your own Ollama; cloud and paid engines are never called.
# You can also change this inside Pixel Pals: Settings -> Local AI.
LOCAL_ONLY_AI=on
