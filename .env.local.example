# Copy to .env.local (git-ignored) and fill in what you use. Restart the server after editing.

# Web search for /search and /research. Default (Docker): http://host.docker.internal:8081
# Without Docker: http://localhost:8081. Your SearXNG must allow JSON (search.formats: [html, json]).
SEARXNG_URL=http://localhost:8081

# @seerr movie/TV requests. The key stays on the server and is never sent to the browser.
SEERR_URL=http://10.200.1.31:5055
SEERR_API_KEY=

# Optional shared password for the whole app (recommended: anyone on your LAN can otherwise open it).
BUDDY_PASSWORD=

# /library lookups in Jellyfin (key: Dashboard -> API Keys). PUBLIC_URL makes results clickable.
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_PUBLIC_URL=

# Unraid health (/server, /diagnose, the red banner). Key: Unraid -> Settings -> Management Access -> API Keys (read-only is enough).
UNRAID_URL=
UNRAID_API_KEY=
UNRAID_CHECK_SECONDS=60
# Optional phone push through ntfy, e.g. https://ntfy.sh/your-long-random-topic
NTFY_URL=

# Plex lookups: /plex <title> and /watch (what should we watch tonight). Token: Plex web -> any item -> ... -> Get Info -> View XML, copy X-Plex-Token from the URL.
PLEX_URL=http://10.200.1.X:32400
PLEX_TOKEN=

# Trakt lists: /trakt lists, /trakt <list>, /next (the pals pick what to watch from a list).
# Client id: trakt.tv/oauth/applications -> New Application (any name, Development type, redirect uri http://localhost:5173/callback - unused).
# Public lists need only the client id and your username. TRAKT_LIST defaults to "watchlist".
TRAKT_CLIENT_ID=
TRAKT_USER=
TRAKT_LIST=watchlist
# Only for private lists:
TRAKT_ACCESS_TOKEN=

# Accounts (Docker build): the first visit asks you to create an account; the owner adds others from the account menu.
# On whenever BUDDY_DATA_DIR is set. Set to 0 to use only the shared BUDDY_PASSWORD instead.
# If BUDDY_PASSWORD is set, it becomes the "setup password" needed to create the first account.
BUDDY_ACCOUNTS=1
