#!/usr/bin/env python3
"""Validate complete PR changes or staged files against per-agent file ownership."""
import argparse
import json
import sys
from guardlib import (GuardError, branch_name, changed_files, cli_error, finding,
                      git, matches, normalize_path, policy, result, select_agent, sha, write_result)

def run(argv=None) -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--agent", help="Agent ID (otherwise inferred from branch)")
    p.add_argument("--branch", help="Explicit checkout branch, required on detached CI HEAD")
    p.add_argument("--base", help="Base ref to compare entire branch against (e.g. origin/beta)")
    p.add_argument("--staged", action="store_true", help="Check staged files for pre-commit")
    p.add_argument("--file", action="append", default=[], help="Check explicit file; repeatable")
    p.add_argument("--policy", help="Alternate policy path for tests")
    p.add_argument("--output", help="Findings JSON path (default tools/out/scope-check-findings.json)")
    args = p.parse_args(argv)
    try:
        if args.staged and args.base:
            raise GuardError("--staged and --base are mutually exclusive")
        data = policy(__import__("pathlib").Path(args.policy) if args.policy else None)
        branch = args.branch or branch_name()
        agent = select_agent(data, branch, args.agent)
        files = ([normalize_path(f) for f in args.file] if args.file
                 else changed_files(args.base, args.staged))
        allowed = data["agents"][agent]["paths"]
        findings = []
        for name in sorted(set(files)):
            if not any(matches(name, pattern) for pattern in allowed):
                findings.append(finding("out-of-scope", "blocker", name, 0,
                      f"{agent} may edit only {allowed}; owner approval needed for this path"))
            elif any(matches(name, pat) for pat in data["shared_readonly"]):
                # An exact, separately named agent path takes precedence. General docs/** does not.
                explicit = any(name == pat for pat in allowed)
                if not explicit:
                    findings.append(finding("readonly-shared", "blocker", name, 0,
                          f"{name} is shared read-only; request owner approval"))
        out = result("scope-check", branch, sha(), findings)
        write_result("scope-check", out, args.output)
        print(json.dumps(out, indent=2))
        return 1 if findings else 0
    except (GuardError, OSError, ValueError) as exc:
        return cli_error("scope-check", exc, args.output)

if __name__ == "__main__":
    sys.exit(run())
