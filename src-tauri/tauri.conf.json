{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelPals",
  "version": "0.1.0",
  "identifier": "app.lovable.pixelpals",
  "build": {
    "devUrl": "http://localhost:8080",
    "frontendDist": "https://buddy-bot-room.lovable.app",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Pixel Pals",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "shortDescription": "AI agent chat room with pixel characters",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
