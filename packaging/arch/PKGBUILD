# Maintainer: nyteghost
# Builds from the local checkout this file lives in — no GitHub login needed.
pkgname=pixelpals
pkgver=0.1.0
pkgrel=1
pkgdesc="Pixel Pals — AI agent chat room with pixel characters (works with local Ollama)"
arch=('x86_64')
url="https://github.com/nyteghost/buddy-bot-room"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
makedepends=('bun' 'rustup' 'python-pillow')
optdepends=('ollama-cuda: fast local AI on NVIDIA GPUs')
source=()
sha256sums=()

_root() { cd "$startdir/../.." && pwd; }

prepare() {
  # rustup ships without a default toolchain
  if ! cargo --version >/dev/null 2>&1; then
    rustup default stable
  fi
  # Tauri requires RGBA icons
  python3 - "$(_root)/src-tauri/icons" <<'PY'
import os, sys
from PIL import Image
d = sys.argv[1]
for f in os.listdir(d):
    if f.endswith('.png'):
        p = os.path.join(d, f)
        Image.open(p).convert('RGBA').save(p)
PY
}

build() {
  cd "$(_root)"
  bun install
  bunx tauri build --bundles deb
}

package() {
  local root; root="$(_root)"
  install -Dm755 "$root/src-tauri/target/release/pixelpals" "$pkgdir/usr/bin/pixelpals"
  install -Dm644 "$root/src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/pixelpals.png"
  install -Dm644 "$root/packaging/pixelpals.desktop" \
    "$pkgdir/usr/share/applications/pixelpals.desktop"
}
