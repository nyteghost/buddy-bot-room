# LOCAL ONLY. Copy OUTSIDE the repository into a private Compose Manager stack.
# Never use any password, API key, backup, or data copied from Pixel Pals/ADHD production.
# Replace image with the exact published DIGEST reported in PR #44.
STAGE4A_IMAGE=ghcr.io/nyteghost/buddy-bot-room@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
STAGE4A_SETUP_CODE=REPLACE_WITH_NEW_DISPOSABLE_12PLUS_CHAR_CODE
# localhost-only by default; to view from another device on the LAN, set to
# your actual private Unraid LAN IP AFTER an isolated-install authorization:
STAGE4A_BIND_IP=127.0.0.1
